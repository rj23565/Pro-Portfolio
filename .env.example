# === Required for production (Vercel) ===
# Generate a 32+ character random string: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Database — durable storage for portfolio data (Vercel Postgres / Neon)
# Create a Postgres DB in Vercel dashboard or Neon, then paste URL here
# Example: postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Vercel Blob — durable object storage for uploads (images, PDFs)
# Create a Blob store in Vercel dashboard → Storage → Blob, then paste token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Optional: restrict initial admin setup to a token (recommended for prod)
# If set, /admin/setup requires this token to create/rotate password
ADMIN_SETUP_TOKEN="optional-setup-token"

# Optional: site URL for metadata / redirects
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# === Local dev fallbacks (no DATABASE_URL / BLOB token) ===
# Data is stored in data/store.json (gitignored) and uploads in public/uploads/
# These are ephemeral on Vercel — you MUST set DATABASE_URL and BLOB_READ_WRITE_TOKEN for production.
